




// Menghubungkan ke file konfigurasi database
require_once 'services/config.php';

// 1. Query SELECT untuk mengambil data Produk
$query_produk = "SELECT * FROM produk";
$result_produk = $conn->query($query_produk);

// 2. Query SELECT dengan JOIN untuk mengambil data Pesanan & Pelanggan
$query_pesanan = "SELECT pesanan.id_pesanan, pelanggan.nama_pelanggan, pelanggan.email, pesanan.tanggal_pesanan, pesanan.total_harga 
                  FROM pesanan 
                                    JOIN pelanggan ON pesanan.id_pelanggan = pelanggan.id_pelanggan 
                                                      ORDER BY pesanan.id_pesanan ASC";
                                                      $result_pesanan = $conn->query($query_pesanan);
                                                      ?>

                                                      <!DOCTYPE html>
                                                      <html lang="id">
                                                      <head>
                                                          <meta charset="UTF-8">
                                                              <meta name="viewport" content="width=device-width, initial-scale=1.0">
                                                                  <title>Sistem Toko ISCOM</title>
                                                                      <link rel="stylesheet" href="style.css">
                                                                                                       <body>

                                                                          <!-- Navbar -->
                                                                              <nav class="navbar">
                                                                                      <div class="logo">Toko ISCOM</div>
                                                                                          </nav>

                                                                                              <div class="container">
                                                                                                      <h2>Daftar Produk</h2>
                                                                                                              <!-- Display Flex/Grid untuk Card Produk -->
                                                                                                                      <div class="card-grid">
                                                                                                                                  <?php while ($produk = $result_produk->fetch_assoc()): ?>
                                                                                                                                                  <div class="card">
                                                                                                                                                                      <h3><?= htmlspecialchars($produk['nama_produk']); ?></h3>
                                                                                                                                                                                          <p class="kategori">Kategori: <?= htmlspecialchars($produk['kategori']); ?></p>
                                                                                                                                                                                                              <p class="harga">Rp <?= number_format($produk['harga'], 0, ',', '.'); ?></p>
                                                                                                                                                                                                                                  <p class="stok">Stok: <?= $produk['stok']; ?></p>
                                                                                                                                                                                                                                                  </div>
                                                                                                                                                                                                                                                              <?php endwhile; ?>
                                                                                                                                                                                                                                                                      </div>

                                                                                                                                                                                                                                                                              <h2>Daftar Transaksi Pesanan (Hasil JOIN)</h2>
                                                                                                                                                                                                                                                                                      <!-- Tabel Data Dinamis -->
                                                                                                                                                                                                                                                                                              <div class="table-responsive">
                                                                                                                                                                                                                                                                                                          <table>
                                                                                                                                                                                                                                                                                                                          <thead>
                                                                                                                                                                                                                                                                                                                                              <tr>
                                                                                                                                                                                                                                                                                                                                                                      <th>ID Pesanan</th>
                                                                                                                                                                                                                                                                                                                                                                                              <th>Nama Pelanggan</th>
                                                                                                                                                                                                                                                                                                                                                                                                                      <th>Email</th>
                                                                                                                                                                                                                                                                                                                                                                                                                                              <th>Tanggal Pesanan</th>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                      <th>Total Harga</th>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          </tr>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          </thead>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          <tbody>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              <?php if ($result_pesanan->num_rows > 0): ?>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      <?php while ($row = $result_pesanan->fetch_assoc()): ?>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  <tr>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  <td>#<?= $row['id_pesanan']; ?></td>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  <td><?= htmlspecialchars($row['nama_pelanggan']); ?></td>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  <td><?= htmlspecialchars($row['email']); ?></td>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  <td><?= $row['tanggal_pesanan']; ?></td>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  <td>Rp <?= number_format($row['total_harga'], 0, ',', '.'); ?></td>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              </tr>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      <?php endwhile; ?>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          <?php else: ?>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  <tr>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              <td colspan="5">Belum ada data pesanan.</td>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      </tr>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          <?php endif; ?>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      </tbody>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      </table>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              </div>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  </div>

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            
